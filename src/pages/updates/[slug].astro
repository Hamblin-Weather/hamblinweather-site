---
import { getCollection } from 'astro:content';
import EditorialArticle from '../../components/EditorialArticle.astro';
import { blogCategory } from '../../data/update-categories';
import { path } from '../../lib/paths';
export async function getStaticPaths() {
  return (await getCollection('updates')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
if (entry.data.category === blogCategory) return Astro.redirect(path('blog/' + entry.id + '/'));
---
<EditorialArticle entry={entry} section="updates/"/>
