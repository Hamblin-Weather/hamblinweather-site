---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import RegionalForecasts from '../../components/RegionalForecasts.astro';
import OutdoorForecasts from '../../components/OutdoorForecasts.astro';
import CoverageArt from '../../components/CoverageArt.astro';
import { counties } from '../../lib/counties';
---
<Base title="County Forecasts" section="forecast/">
  <div class="shell page-body">
    <SectionHeading title="West Tennessee Forecasts"/>
    <RegionalForecasts/>
    <OutdoorForecasts/>
    <section class="county-directory" aria-labelledby="county-directory-heading">
      <div class="section-bar"><h2 id="county-directory-heading">County Forecasts</h2></div>
      <div class="directory-tools">
        <div class="search-field">
          <Icon name="search" size={21}/>
          <input type="search" id="county-search" aria-label="Search your county here" placeholder="Search your county here" autocomplete="off"/>
        </div>
        <p id="county-count" class="muted" role="status">{counties.length} counties</p>
      </div>
      <p class="panel empty" id="county-empty" hidden>No matching counties. Try a different county or town.</p>
      <div class="directory-map"><CoverageArt/></div>
    </section>
  </div>
</Base>
<script>
  import { counties, savedCounty } from '../../lib/counties';
  const search = document.querySelector<HTMLInputElement>('#county-search')!;
  const count = document.querySelector<HTMLElement>('#county-count')!;
  const empty = document.querySelector<HTMLElement>('#county-empty')!;
  const saved = savedCounty();
  const links = Array.from(document.querySelectorAll<SVGAElement>('.directory-map .coverage-county'), (link) => {
    const fips = link.querySelector('path')?.getAttribute('data-county');
    const county = counties.find((entry) => entry.fips === fips)!;
    if (county.slug === saved?.slug) {
      link.setAttribute('data-saved-county', '');
      link.setAttribute('aria-description', 'Saved county');
    }
    return { link, href: link.getAttribute('href')!, terms: (county.name + ' County ' + county.place).toLowerCase() };
  });
  function filter() {
    const words = search.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
    let matches = 0;
    for (const { link, href, terms } of links) {
      const match = words.every((word) => terms.includes(word));
      link.toggleAttribute('data-search-match', match && words.length > 0);
      link.toggleAttribute('data-filtered-out', !match);
      if (match) {
        matches++;
        link.setAttribute('href', href);
        link.removeAttribute('aria-hidden');
      } else {
        link.removeAttribute('href');
        link.setAttribute('aria-hidden', 'true');
      }
    }
    count.textContent = matches + (matches === 1 ? ' county' : ' counties');
    empty.hidden = matches !== 0;
  }
  search.addEventListener('input', filter);
  filter();
</script>
<style>
  .county-directory { margin-top: 29px; }
  .directory-tools { display: flex; align-items: center; justify-content: space-between; gap: 8px 14px; flex-wrap: wrap; margin-bottom: 14px; }
  .search-field { flex: 1 1 14rem; max-width: 400px; }
  #county-count { font-size: 14px; }
  #county-empty { margin: 0 0 14px; padding: 12px 16px; }
  .directory-map {
    display: grid;
    place-items: center;
    padding: clamp(10px, 2vw, 24px);
    border-radius: 14px;
    background: radial-gradient(ellipse at 55% 40%, #274c95, #101c42 77%);
  }
  .directory-map :global(.coverage-svg) { display: block; width: min(100%, 560px); }
  .directory-map :global(.coverage-county[data-saved-county]:not(:focus-visible) path) { fill-opacity: .72; }
  .directory-map :global(.coverage-county[data-search-match]:not(:focus-visible) path) { fill-opacity: .95; stroke: #f0f4ff; stroke-width: 1.6; }
  .directory-map :global(.coverage-county[data-filtered-out]) { opacity: .28; pointer-events: none; }
</style>
