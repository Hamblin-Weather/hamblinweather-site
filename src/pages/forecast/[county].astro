---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import CountyOptions from '../../components/CountyOptions.astro';
import { counties, officialForecast, type County } from '../../lib/counties';
import { path } from '../../lib/paths';
export function getStaticPaths() {
  return counties.map((county) => ({ params: { county: county.slug }, props: { county } }));
}
const { county } = Astro.props as { county: County };
const official = officialForecast(county);
---
<Base title={county.name + ' County Forecast'} section="forecast/">
  <div class="shell page-body" id="county-forecast" data-county={county.slug}>
    <a class="breadcrumb" href={path('forecast/')}>← All county forecasts</a>
    <SectionHeading eyebrow="COUNTY FORECAST" icon="pin" title={county.name + ' County'}/>
    <div class="forecast-toolbar">
      <div><label class="field-label" for="switch-county">Change county</label><select id="switch-county"><CountyOptions selected={county.slug}/></select></div>
      <button class="button button-outline" id="save-county" type="button">Save this county</button>
      <a class="text-link" href={official}>Official NWS forecast <Icon name="diagonal" size={16}/></a>
      <small id="save-county-message" role="status"></small>
    </div>
    <div class="forecast-top">
      <section class="panel observed-card" aria-labelledby="current-heading">
        <div class="observed-header">
          <h2 id="current-heading">Current Conditions</h2>
          <img class="observation-symbol" alt="" hidden/>
        </div>
        <div id="observed-data" role="status">Loading nearby station observations…</div>
      </section>
      <section class="panel" aria-labelledby="period-heading">
        <h2 id="period-heading">Today & Tonight</h2>
        <div id="near-term" role="status">Loading the next forecast periods…</div>
      </section>
    </div>
    <section class="panel forecast-detail" aria-labelledby="hourly-heading">
      <h2 id="hourly-heading">Hourly Trend</h2>
      <div id="hourly-data" aria-live="polite">Loading hourly forecast…</div>
    </section>
    <section class="panel forecast-detail" aria-labelledby="extended-heading">
      <h2 id="extended-heading">Extended Forecast</h2>
      <div id="extended-data" aria-live="polite">Loading extended forecast…</div>
    </section>
    <noscript><p>Use the <a href={official}>official forecast for {county.place}</a> for the latest weather data.</p></noscript>
  </div>
</Base>
<script>import '../../lib/county-page';</script>
