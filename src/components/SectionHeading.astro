---
import Icon from './Icon.astro';
interface Props { eyebrow?: string; title: string; text?: string; icon?: string }
const { eyebrow, title, text, icon } = Astro.props;
---
<div class:list={['page-heading', { 'page-heading--title-only': !eyebrow && !text }]}>
  {eyebrow && <p class="eyebrow">{icon && <Icon name={icon} size={16}/>} {eyebrow}</p>}
  <h1>{title}</h1>
  {text && <p class="lede">{text}</p>}
</div>
