---
import layout from '../data/forecast-frame-layout.json';
import geography from '../data/forecast-frame-geography.json';
import coverage from '../data/hero-coverage.geo.json';
import { temperatureStops } from '../lib/forecast-frames';
import { path } from '../lib/paths';

interface Props { id: string; title: string; night?: boolean; hometown?: (typeof layout.hometown)[number] }
const { id, title, night = false, hometown } = Astro.props;
const config = hometown ?? layout.regional;
const prefix = 'forecast-map-' + id;
const label = hometown?.title ?? title;
const [west, south, east, north] = config.bounds;
const project = ([lon, lat]: number[]) => [(lon - west) * 1332 / (east - west), (north - lat) * 803 / (north - south)];
const line = (coords: number[][]) =>
  'M' + coords.map((xy) => project(xy).map((v) => v.toFixed(1)).join(',')).join('L');
const boundary = (geometry: { type: string; coordinates: unknown }) =>
  ((geometry.type === 'Polygon' ? [geometry.coordinates] : geometry.coordinates) as number[][][][])
    .flatMap((polygon) => polygon.map((ring) => line(ring) + 'Z')).join('');
const countyPaths = coverage.features.map(({ geometry }) => boundary(geometry));
---
<figure class="forecast-map" data-forecast-frame={id} data-frame-period={night ? 'lows' : 'highs'}>
  <button type="button" class="forecast-map-trigger" data-enlarge-frame aria-label={'Enlarge map for ' + label} aria-haspopup="dialog" aria-controls={prefix + '-dialog'} disabled>
    <svg class="forecast-map-canvas" viewBox="0 0 1332 803" width="1332" height="803" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
      <defs>
        {hometown ? (
          <filter id={prefix + '-terrain'} color-interpolation-filters="sRGB">
            <feColorMatrix type="saturate" values="1.48"/>
            <feComponentTransfer><feFuncR type="linear" slope=".75"/><feFuncG type="linear" slope=".83"/><feFuncB type="linear" slope=".58"/></feComponentTransfer>
          </filter>
        ) : (
          <>
            <clipPath id={prefix + '-thermal-mask'}>{countyPaths.map((d) => <path d={d} fill-rule="evenodd"/>)}</clipPath>
            {config.labels.map(([name, x, y], i) => (
              <radialGradient id={prefix + '-local-' + i} gradientUnits="userSpaceOnUse" cx={x} cy={y} r="156" data-thermal-town={name}>
                <stop stop-color="#7f8c8e" stop-opacity=".95"/><stop offset="1" stop-color="#7f8c8e" stop-opacity="0"/>
              </radialGradient>
            ))}
            <linearGradient id={prefix + '-scale'}>
              {temperatureStops.map(([value, color]) => <stop offset={value + '%'} stop-color={color}/>)}
            </linearGradient>
          </>
        )}
      </defs>
      {hometown ? (
        <image href={path('forecast-maps/' + hometown.id + '.jpg')} width="1332" height="803" preserveAspectRatio="none" filter={'url(#' + prefix + '-terrain)'}/>
      ) : (
        <rect data-thermal-background width="1332" height="803" fill={night ? '#3b777b' : '#718831'}/>
      )}
      <g fill="none" stroke="#080d07" stroke-width="2.2" stroke-linejoin="round">
        {geography.states.map((geometry) => <path d={boundary(geometry)}/>)}
      </g>
      {!hometown && <g transform="translate(14 6)" fill="#000" fill-opacity=".63">{countyPaths.map((d) => <path d={d} fill-rule="evenodd"/>)}</g>}
      {!hometown && <g clip-path={'url(#' + prefix + '-thermal-mask)'}>
        <rect width="1332" height="803" fill="#7f8c8e" data-thermal-field/>
        {config.labels.map((_, i) => <rect width="1332" height="803" fill={'url(#' + prefix + '-local-' + i + ')'} data-thermal-wash={i} visibility="hidden"/>)}
      </g>}
      <g fill="none" stroke="#0b1108" stroke-width={hometown ? '2.1' : '1.6'} stroke-linejoin="round">
        {countyPaths.map((d) => <path d={d}/>)}
      </g>
      {!hometown && (
        <g stroke="#ffdc27" stroke-width="1.4" stroke-opacity=".9" fill="none">
          {geography.roads.map(({ coordinates }) => <path d={line(coordinates)}/>)}
        </g>
      )}
      <g class:list={{ 'hometown-map-labels': hometown }}>
        {config.labels.map(([name, x, y]) => {
          const labelWidth = Math.ceil(String(name).length * (hometown ? 7.4 : 10.6) + 10);
          return <g transform={'translate(' + x + ' ' + y + ')'}>
            {hometown && <rect x="-21" y="-16" width="42" height="32" rx="4" fill="#183ba6" stroke="#ebf3ff" stroke-width="1.3"/>}
            <text y={hometown ? '7.5' : '12'} class="map-temp" data-map-value={name}>—</text>
            <rect x={-labelWidth / 2} y={hometown ? 24 : 22} width={labelWidth} height={hometown ? 18 : 28} rx={hometown ? 1 : 4} fill="#040804" fill-opacity={hometown ? '.86' : '.65'}/>
            <text y={hometown ? '37' : '42'} class="map-name">{name}</text>
          </g>;
        })}
      </g>
      <g stroke="#080f1c" stroke-width="2.7">
        <rect x="286" y="13" width="1021" height="69" fill="#fff"/>
        <rect x="286" y="82" width="1021" height="42" fill="#21a7ed"/>
        {!hometown && <rect x="286" y="123" width="1021" height="27" fill={'url(#' + prefix + '-scale)'}/>}
        <rect x="25" y="4" width="268" height="125" rx="9" fill="#fff"/>
      </g>
      <image href={path('brand/hamblin-weather.png')} x="32" y="9" width="253" height="116" preserveAspectRatio="xMidYMid meet"/>
      <g fill="#071e2b" font-weight="900">
        <text x="301" y="63" font-size="42">{title}</text>
        <text x="301" y="111" font-size="22" data-frame-period-label>Loading forecast period…</text>
      </g>
      {!hometown && Array.from({ length: 11 }, (_, i) => <text x={308 + i * 97.2} y="143" text-anchor="middle" font-size="19" font-weight="830">{i * 10}°{i === 10 ? 'F' : ''}</text>)}
    </svg>
  </button>
  <dialog class="forecast-map-dialog" id={prefix + '-dialog'} data-frame-dialog aria-labelledby={prefix + '-title'}>
    <div class="forecast-map-dialog-bar">
      <h3 id={prefix + '-title'}>{label}</h3>
      <form method="dialog"><button class="button button-outline" autofocus>Close</button></form>
    </div>
    <div class="forecast-map-viewport" data-frame-viewport tabindex="0" role="region" aria-label="Enlarged forecast map"></div>
  </dialog>
  <details class="map-readable">
    <summary>Forecast details<span class="sr-only"> for {label}</span></summary>
    <p data-frame-date>Loading forecast period…</p>
    <p>Temperatures in Fahrenheit. Forecast data from the National Weather Service. Boundaries from the U.S. Census Bureau.{hometown && ' Aerial imagery from the USGS National Map.'}</p>
    <ul>
      {config.labels.map(([name]) => <li><strong>{name}</strong><span><span data-readable-value={name}>Loading…</span><span data-readable-condition={name}></span></span></li>)}
    </ul>
  </details>
</figure>

<style>
  .forecast-map { margin: 0; min-width: 0; }
  .forecast-map-trigger {
    display: block;
    width: 100%;
    aspect-ratio: 1332 / 803;
    padding: 0;
    border: 0;
    background: #071a47;
    overflow: hidden;
    cursor: zoom-in;
  }
  .forecast-map-trigger:disabled { opacity: 1; }
  .forecast-map-canvas { display: block; width: 100%; height: auto; font-family: Inter Variable, Arial, sans-serif; }
  .forecast-map-dialog {
    width: min(96vw, 1480px);
    max-width: none;
    max-height: 92vh;
    max-height: 92dvh;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 10px;
    color: var(--ink);
    background: var(--white);
  }
  .forecast-map-dialog[open] { display: flex; flex-direction: column; }
  .forecast-map-dialog::backdrop { background: #07152bcc; }
  :global(html:has(.forecast-map-dialog[open])) { overflow: hidden; }
  .forecast-map-dialog-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 12px; }
  .forecast-map-viewport { width: 100%; overflow: auto; overscroll-behavior: contain; background: #071a47; }
  .forecast-map-viewport:focus-visible { outline-offset: -4px; }
  .forecast-map-viewport .forecast-map-canvas { width: max(1080px, 100%); }
  .map-temp, .map-name { text-anchor: middle; fill: #fff; paint-order: stroke; stroke-linejoin: round; }
  .map-temp { font-size: 35px; font-weight: 830; stroke: #080f07; stroke-width: 3.3px; }
  .map-name { font-size: 19px; stroke: #080b08; stroke-width: 1.8px; }
  .hometown-map-labels .map-temp { font-size: 23px; stroke-width: 2px; }
  .hometown-map-labels .map-temp[data-missing] { font-size: 17px; }
  .hometown-map-labels .map-name { font-size: 13px; font-weight: 750; stroke-width: 1px; }
  .map-readable { margin-top: 5px; }
  .map-readable summary { width: fit-content; cursor: pointer; padding: 6px 0; color: var(--blue); font-size: 14px; font-weight: 740; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .map-readable p { color: var(--muted); margin-bottom: 6px; font-size: 13px; }
  .map-readable ul { margin: 0; padding: 0; list-style: none; max-width: 670px; }
  .map-readable li { display: grid; grid-template-columns: minmax(90px, .75fr) minmax(0, 1.25fr); gap: 7px 14px; border-top: 1px solid var(--line); padding: 4px 0; font-size: 14px; }
</style>
